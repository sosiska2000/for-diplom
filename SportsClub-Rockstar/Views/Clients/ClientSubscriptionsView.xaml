<Page x:Class="Rockstar.Admin.WPF.Views.Clients.ClientSubscriptionsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Background="#F5F7FA"
      Title="Абонементы клиента">

    <Page.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF4D00"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E64500"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#FF4D00"/>
            <Setter Property="BorderBrush" Value="#FF4D00"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFF5F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E8E8ED"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="12" Direction="270" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Foreground" Value="#FF4D00"/>
            <Setter Property="Background" Value="#E8E8ED"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <Border x:Name="PART_Track" CornerRadius="3">
                                <Border x:Name="PART_Indicator" 
                                        Background="{TemplateBinding Foreground}" 
                                        CornerRadius="3"
                                        HorizontalAlignment="Left"/>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        
        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Управление абонементами" 
                       FontSize="24" 
                       FontWeight="SemiBold" 
                       Foreground="#2C2C2E"
                       />
            <Button Content="Назад" 
                        Width="100" Height="40"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="OnBackClicked"
                        Margin="0,0,0,24"/>
            
            <TextBlock Margin="0,4,0,0">
                        <Run Text="Клиент:" Foreground="#8E8E93"/>
                        <Run Text="{Binding ClientName, Mode=OneWay}" Foreground="#FF4D00" FontWeight="SemiBold"/>
            </TextBlock>
            
        </StackPanel>

        <!-- Список абонементов -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Subscriptions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Левая часть - информация -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding SubscriptionName}" 
                                               FontSize="16" 
                                               FontWeight="SemiBold" 
                                               Foreground="#2C2C2E"/>
                                    <TextBlock Text="{Binding DirectionName}" 
                                               FontSize="13" 
                                               Foreground="#FF4D00" 
                                               Margin="0,4,0,0"/>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" FontSize="13" Foreground="#666666">
                                            <Run Text="Использовано:"/>
                                            <Run Text="{Binding SessionsUsed}" FontWeight="SemiBold" Foreground="#2C2C2E"/>
                                            <Run Text="/"/>
                                            <Run Text="{Binding TotalSessions}"/>
                                        </TextBlock>

                                        <TextBlock Grid.Column="1" FontSize="13" FontWeight="SemiBold">
                                            <Run Text="Осталось:"/>
                                            <Run Text="{Binding SessionsRemaining}" Foreground="#4CAF50"/>
                                        </TextBlock>
                                    </Grid>

                                    <ProgressBar Style="{StaticResource ProgressBarStyle}" 
                                                 Margin="0,8,0,0"
                                                 Value="{Binding SessionsUsed}" 
                                                 Maximum="{Binding TotalSessions}"/>

                                    <TextBlock FontSize="11" Foreground="#8E8E93" Margin="0,8,0,0">
                                        <Run Text="Действует до:"/>
                                        <Run Text="{Binding ExpiryDate, StringFormat=dd.MM.yyyy}"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Правая часть - кнопки +/– -->
                                <StackPanel Grid.Column="1" 
                                            Orientation="Horizontal" 
                                            VerticalAlignment="Center"
                                            Margin="16,0,0,0">
                                    <Button Content="−" 
                                            Width="44" Height="44"
                                            FontSize="20" FontWeight="Bold"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding DataContext.UseSessionCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding Id}"
                                            Margin="0,0,8,0"/>
                                    <Button Content="+" 
                                            Width="44" Height="44"
                                            FontSize="20" FontWeight="Bold"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding DataContext.AddSessionCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding Id}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Панель добавления абонемента -->
        <Border Grid.Row="2" 
                Style="{StaticResource CardStyle}" 
                Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="Добавить абонемент" 
                           FontSize="16" 
                           FontWeight="SemiBold" 
                           Foreground="#2C2C2E"
                           Margin="0,0,0,16"/>

                <ComboBox ItemsSource="{Binding AvailableSubscriptions}"
                          SelectedItem="{Binding SelectedSubscription}"
                          DisplayMemberPath="Name"
                          Height="44"
                          FontSize="14"
                          Margin="0,0,0,12"/>

                <DatePicker SelectedDate="{Binding ExpiryDate}" 
                            Height="44"
                            FontSize="14"
                            Margin="0,0,0,16"/>

                <Button Content="Добавить абонемент"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding PurchaseCommand}"
                        IsEnabled="{Binding CanPurchase}"
                        Height="44"/>
                
            </StackPanel>
        </Border>

        <!-- Индикатор загрузки -->
        <Grid Grid.Row="1" 
              Background="#CCFFFFFF" 
              Visibility="{Binding LoadingVisibility}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="#FF4D00"/>
                <TextBlock Text="Загрузка..." Margin="0,12,0,0" FontSize="14" Foreground="#666666"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>