<UserControl x:Class="Rockstar.Admin.WPF.Views.Clients.Controls.ClientCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="350" d:DesignWidth="350"
             x:Name="CardControl">

    <Border Background="White" 
            CornerRadius="12" 
            BorderThickness="1" 
            BorderBrush="#E8E8ED"
            Padding="0"
            Margin="8"
            Width="350">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="20" Direction="270" ShadowDepth="4"/>
        </Border.Effect>

        <!-- Информация о клиенте (без фото) -->
        <StackPanel Margin="20">
            <!-- Иконка пользователя вместо фото -->
            <Border Background="#FF4D00"
                    HorizontalAlignment="Left"
                    Width="50"
                    Height="50"
                    CornerRadius="25"
                    Margin="0,0,0,12">
                <TextBlock Text="{Binding Initials, ElementName=CardControl}"
                           FontSize="20"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="White"/>
            </Border>

            <TextBlock Text="{Binding FullName, ElementName=CardControl}"
                       FontSize="18" 
                       FontWeight="SemiBold"
                       Foreground="#2C2C2E"
                       Margin="0,0,0,8"/>

            <TextBlock Text="{Binding Email, ElementName=CardControl}"
                       FontSize="13" 
                       Foreground="#8E8E93"
                       Margin="0,0,0,4"/>

            <TextBlock Text="{Binding PhoneText, ElementName=CardControl}"
                       FontSize="13" 
                       Foreground="#8E8E93"
                       Margin="0,0,0,12"/>

            <TextBlock Text="{Binding AgeText, ElementName=CardControl}"
                       FontSize="13" 
                       Foreground="#666666"
                       Margin="0,0,0,16"/>

            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Left">
                <Button Content="Редактировать"
                        Background="Transparent"
                        Foreground="#FF4D00"
                        FontSize="12"
                        Cursor="Hand"
                        Command="{Binding EditCommand, ElementName=CardControl}"
                        CommandParameter="{Binding Client, ElementName=CardControl}"
                        Margin="0,0,12,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="8,4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FFF5F0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- НОВАЯ КНОПКА "АБОНЕМЕНТЫ" -->
                <Button Content="Абонементы"
                        Background="Transparent"
                        Foreground="#4CAF50"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Command="{Binding DataContext.OpenSubscriptionsCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                        CommandParameter="{Binding Client, ElementName=CardControl}"
                        Margin="0,0,12,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="8,4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E8F5E9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Content="Удалить"
                        Background="Transparent"
                        Foreground="#FF5252"
                        FontSize="12"
                        Cursor="Hand"
                        Command="{Binding DeleteCommand, ElementName=CardControl}"
                        CommandParameter="{Binding Client, ElementName=CardControl}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="8,4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FFF5F0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>