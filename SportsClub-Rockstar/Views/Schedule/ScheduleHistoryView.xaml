<Page x:Class="Rockstar.Admin.WPF.Views.Schedule.ScheduleHistoryView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="750" d:DesignWidth="1100"
      Background="#F5F7FA"
      Title="ScheduleHistoryView"
      x:Name="HistoryPage">

    <Page.Resources>
        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2C2C2E"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF4D00"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E64500"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HistoryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E8E8ED"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Width" Value="320"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="20" Direction="270" ShadowDepth="4"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E8E8ED"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="12,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DatePickerStyle" TargetType="DatePicker">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Page.Resources>

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и кнопка назад -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="История занятий" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="Все прошедшие групповые и персональные тренировки" 
                           FontSize="14" Foreground="#8E8E93" Margin="0,4,0,0"/>
            </StackPanel>

            <Button Grid.Column="1" 
                    Content="Назад" 
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="BackButton_Click"
                    Width="100"/>
        </Grid>

        <!-- Фильтры -->
        <Border Grid.Row="1" 
                Background="White" 
                CornerRadius="12" 
                BorderThickness="1" 
                BorderBrush="#E8E8ED"
                Padding="16"
                Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <DatePicker x:Name="dpFromDate" 
                                Style="{StaticResource DatePickerStyle}"
                                Width="150"
                                Margin="0,0,10,0"/>
                    <TextBlock Text="—" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <DatePicker x:Name="dpToDate" 
                                Style="{StaticResource DatePickerStyle}"
                                Width="150"
                                Margin="0,0,10,0"/>
                    <Button Content="Применить фильтр" 
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="ApplyFilter_Click"
                            Background="White" 
                            Foreground="#FF4D00"
                            BorderBrush="#FF4D00" 
                            BorderThickness="1"
                            Width="140"/>
                </StackPanel>

                <TextBox Grid.Column="1" 
                         x:Name="tbSearch"
                         Style="{StaticResource SearchBoxStyle}"
                         TextChanged="Search_TextChanged"
                         Width="200"
                         ToolTip="Поиск по направлению, тренеру или услуге"/>
            </Grid>
        </Border>

        <!-- Счётчик -->
        <TextBlock Grid.Row="2" 
                   Text="{Binding HistoryCount, StringFormat='Всего записей: {0}'}" 
                   FontSize="14" Foreground="#666666"
                   Margin="0,0,0,10"/>

        <!-- Список истории -->
        <ScrollViewer Grid.Row="3" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="icHistory" ItemsSource="{Binding HistoryItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource HistoryCardStyle}"
                                MouseLeftButtonDown="ScheduleCard_MouseDown"
                                Tag="{Binding Id}">
                            <StackPanel>
                                <!-- Статус (прошло) -->
                                <Border Background="#9E9E9E" 
                                        CornerRadius="16" 
                                        Padding="8,4" 
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,8">
                                    <TextBlock Text="ПРОШЛО" 
                                               FontSize="10" 
                                               FontWeight="Bold"
                                               Foreground="White"/>
                                </Border>

                                <!-- Направление -->
                                <TextBlock Text="{Binding DirectionName}" 
                                           FontSize="18" 
                                           FontWeight="SemiBold" 
                                           Foreground="#2C2C2E"/>
                                <TextBlock Text="{Binding ServiceName}" 
                                           FontSize="14" 
                                           Foreground="#FF4D00" 
                                           Margin="0,4,0,0"/>

                                <!-- Тренер -->
                                <TextBlock Text="{Binding TrainerName}" 
                                           FontSize="14" 
                                           Foreground="#666666" 
                                           Margin="0,8,0,0"/>

                                <!-- Тип занятия -->
                                <TextBlock Text="{Binding SessionType}" 
                                           FontSize="12" 
                                           Foreground="#8E8E93" 
                                           Margin="0,4,0,0"/>

                                <!-- Дата и время -->
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Дата" FontSize="12" Foreground="#8E8E93"/>
                                        <TextBlock Text="{Binding DateDisplay}" 
                                                   FontSize="14" FontWeight="Medium" 
                                                   Foreground="#2C2C2E"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Время" FontSize="12" Foreground="#8E8E93"/>
                                        <TextBlock Text="{Binding TimeRange}" 
                                                   FontSize="14" FontWeight="Medium" 
                                                   Foreground="#2C2C2E"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Участники -->
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Записано" FontSize="12" Foreground="#8E8E93"/>
                                        <TextBlock Text="{Binding ParticipantsDisplay}" 
                                                   FontSize="14" FontWeight="Medium" 
                                                   Foreground="#2C2C2E"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Цена" FontSize="12" Foreground="#8E8E93"/>
                                        <TextBlock Text="{Binding Price, StringFormat={}{0} ₽}" 
                                                   FontSize="14" FontWeight="Medium" 
                                                   Foreground="#2C2C2E"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>