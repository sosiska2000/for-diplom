<Page x:Class="Rockstar.Admin.WPF.Views.Schedule.ScheduleView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="750" d:DesignWidth="1100"
      Background="#F5F7FA"
      Title="ScheduleView"
      x:Name="SchedulePage">

    <Page.Resources>
        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2C2C2E"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF4D00"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E64500"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E8E8ED"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="12,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScheduleCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E8E8ED"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Width" Value="320"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="20" Direction="270" ShadowDepth="4"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== ВЕРХНЯЯ ПАНЕЛЬ ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Расписание групповых занятий" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="Управление групповыми тренировками"
                           FontSize="14"
                           Foreground="#8E8E93"
                           Margin="0,4,0,0"/>
            </StackPanel>


            <Button Grid.Column="1"
                    Content="Обновить"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding RefreshCommand}"
                    Background="White" Foreground="#FF4D00"
                    BorderBrush="#FF4D00" BorderThickness="1"
                    Width="100" Margin="0,0,10,0"/>

            <Button Grid.Column="2"
                    Content="+ Добавить"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding AddScheduleCommand}"
                    Width="140" Margin="0,0,10,0"/>

            <Button Grid.Column="3"
                    Content="Назад"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding BackCommand}"
                    Width="100"/>
            <!-- В верхнюю панель добавьте кнопку -->
            <Button
        Content="История"
        Style="{StaticResource PrimaryButtonStyle}"
        Command="{Binding OpenHistoryCommand}"
        Background="White" Foreground="#FF4D00"
        BorderBrush="#FF4D00" BorderThickness="1"
        Width="100" Margin="530,7.5,10,7.5"/>
        </Grid>

        <!-- ===== ПАНЕЛЬ ПОИСКА ===== -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <TextBox Style="{StaticResource SearchBoxStyle}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>

        <!-- ===== СЧЁТЧИКИ ===== -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Всего занятий: " Foreground="#666666"/>
            <TextBlock Text="{Binding AllSchedulesCount}" Foreground="#FF4D00" FontWeight="Bold" Margin="0,0,20,0"/>
            <TextBlock Text="Отфильтровано: " Foreground="#666666"/>
            <TextBlock Text="{Binding FilteredSchedulesCount}" Foreground="#FF4D00" FontWeight="Bold" Margin="0,0,20,0"/>
            <TextBlock Text="Поиск: " Foreground="#666666"/>
            <TextBlock Text="{Binding SearchText, TargetNullValue=''}" Foreground="#FF4D00" FontWeight="Bold"/>
        </StackPanel>

        <!-- ===== ИНДИКАТОР ЗАГРУЗКИ ===== -->
        <Grid Grid.Row="3" Visibility="{Binding LoadingVisibility}" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="300" Height="4" Foreground="#FF4D00"/>
                <TextBlock Text="Загрузка расписания..."
                           FontSize="14" Foreground="#8E8E93"
                           Margin="0,16,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- ===== СПИСОК ЗАНЯТИЙ ===== -->
        <ScrollViewer Grid.Row="3"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding ContentVisibility}">
            <ItemsControl ItemsSource="{Binding FilteredSchedules}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ScheduleCardStyle}"
                                MouseLeftButtonDown="ScheduleCard_MouseDown"
                                Tag="{Binding Id}">
                            <StackPanel>
                                <TextBlock Text="{Binding DirectionName}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#2C2C2E"/>
                                <TextBlock Text="{Binding ServiceName}"
                                           FontSize="14"
                                           Foreground="#FF4D00"
                                           Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding TrainerName}"
                                           FontSize="14"
                                           Foreground="#666666"
                                           Margin="0,8,0,0"/>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Дата"
                                                   FontSize="12"
                                                   Foreground="#8E8E93"/>
                                        <TextBlock Text="{Binding DateDisplay}"
                                                   FontSize="14"
                                                   FontWeight="Medium"
                                                   Foreground="#2C2C2E"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Время"
                                                   FontSize="12"
                                                   Foreground="#8E8E93"/>
                                        <TextBlock Text="{Binding TimeRange}"
                                                   FontSize="14"
                                                   FontWeight="Medium"
                                                   Foreground="#2C2C2E"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Участники"
                                                   FontSize="12"
                                                   Foreground="#8E8E93"/>
                                        <TextBlock Text="{Binding ParticipantsDisplay}"
                                                   FontSize="14"
                                                   FontWeight="Medium"
                                                   Foreground="#2C2C2E"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Цена"
                                                   FontSize="12"
                                                   Foreground="#8E8E93"/>
                                        <TextBlock Text="{Binding Price, StringFormat={}{0} ₽}"
                                                   FontSize="14"
                                                   FontWeight="Medium"
                                                   Foreground="#2C2C2E"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="0,16,0,0">
                                    <Button Content="✏️"
                                            Background="Transparent"
                                            Foreground="#666666"
                                            FontSize="16"
                                            Padding="8"
                                            Command="{Binding DataContext.OpenScheduleDetailsCommand, ElementName=SchedulePage}"
        CommandParameter="{Binding Id}"
                                            Margin="0,0,8,0"/>
                                    <Button Content="🗑️"
                                            Background="Transparent"
                                            Foreground="#FF5252"
                                            FontSize="16"
                                            Padding="8"
                                            Command="{Binding DataContext.DeleteScheduleCommand, ElementName=SchedulePage}"
                                            CommandParameter="{Binding Id}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>