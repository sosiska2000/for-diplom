<Page x:Class="Rockstar.Admin.WPF.Views.Trainers.TrainersView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:controls="clr-namespace:Rockstar.Admin.WPF.Views.Trainers.Controls"
      mc:Ignorable="d"
      d:DesignHeight="750" d:DesignWidth="1100"
      Background="#F5F7FA"
      Title="TrainersView"
      x:Name="TrainersPage">

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и кнопки -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Тренерский состав" FontSize="24" FontWeight="SemiBold" Foreground="#2C2C2E"/>
                <TextBlock Text="Управление профайлами тренеров клуба" FontSize="14" Foreground="#8E8E93" Margin="0,4,0,0"/>
            </StackPanel>

            <Button Grid.Column="1" Content="Обновить" Command="{Binding RefreshCommand}"
                    Background="White" Foreground="#FF4D00" BorderBrush="#FF4D00" BorderThickness="1"
                    Width="100" Margin="0,0,10,0" Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Grid.Column="2" Content="+ Добавить" Command="{Binding AddTrainerCommand}"
                    Width="120" Margin="0,0,10,0" Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Grid.Column="3" Content="Назад" Command="{Binding BackCommand}"
                    Width="100" Style="{StaticResource PrimaryButtonStyle}"/>
        </Grid>

        <!-- Фильтры -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" BorderThickness="1" BorderBrush="#E8E8ED" Padding="16" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Фильтр по направлениям" FontSize="14" FontWeight="SemiBold" Foreground="#2C2C2E" Margin="0,0,0,12"/>
                <WrapPanel>
                    <CheckBox Content="Йога" IsChecked="{Binding FilterYoga}" Margin="0,0,20,0"/>
                    <CheckBox Content="Фитнес" IsChecked="{Binding FilterFitness}" Margin="0,0,20,0"/>
                    <CheckBox Content="Скалолазание" IsChecked="{Binding FilterClimbing}" Margin="0,0,20,0"/>
                </WrapPanel>
                <Button Content="Сбросить фильтры" Command="{Binding ClearFiltersCommand}"
                        Background="Transparent" Foreground="#FF4D00" FontSize="12" BorderThickness="0" Cursor="Hand"
                        HorizontalAlignment="Left" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>

        <!-- Поиск -->
        <TextBox Grid.Row="2" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,20" Height="40" Padding="12,0" FontSize="14"
                 Background="White" BorderBrush="#E8E8ED" BorderThickness="1" Tag="Поиск..."/>

        <!-- Счётчики -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,60,0,0" Height="30" Grid.RowSpan="2" VerticalAlignment="Top">
            <TextBlock Text="Всего: " Foreground="#666666"/>
            <TextBlock Text="{Binding AllTrainersCount}" Foreground="#FF4D00" FontWeight="Bold"/>
            <TextBlock Text=" | Отфильтровано: " Foreground="#666666" Margin="20,0,0,0"/>
            <TextBlock Text="{Binding Trainers.Count}" Foreground="#FF4D00" FontWeight="Bold"/>
        </StackPanel>

        <!-- Список карточек -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding ContentVisibility}" Margin="0,35,0,0">
            <ItemsControl ItemsSource="{Binding Trainers}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:TrainerCardControl Trainer="{Binding}"
                            EditCommand="{Binding DataContext.EditTrainerCommand, ElementName=TrainersPage}"
                            DeleteCommand="{Binding DataContext.DeleteTrainerCommand, ElementName=TrainersPage}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>