<UserControl x:Class="Rockstar.Admin.WPF.Views.Trainers.Controls.TrainerCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="320"
             x:Name="CardControl">

    <Border Background="White"
            CornerRadius="12"
            BorderThickness="1"
            BorderBrush="#E8E8ED"
            Padding="0"
            Margin="8"
            Width="320">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="20" Direction="270" ShadowDepth="4"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Фото тренера -->
            <Border Grid.Row="0" Height="200" Background="#F5F7FA" ClipToBounds="True">
                <Grid>
                    <Border Background="#E8E8ED"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Width="80"
                            Height="80"
                            CornerRadius="40">
                        <TextBlock Text="👨‍🏫"
                                   FontSize="40"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#999999"/>
                    </Border>
                    <Image Source="{Binding PhotoSource, ElementName=CardControl}"
                           Stretch="UniformToFill"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Информация о тренере -->
            <StackPanel Grid.Row="1" Margin="16">
                <!-- Имя -->
                <TextBlock Text="{Binding FullName, ElementName=CardControl}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#2C2C2E"
                           TextWrapping="Wrap"
                           Margin="0,0,0,4"/>

                <!-- Направления (цветной бейдж) -->
                <Border Background="#FFF5F0"
                        CornerRadius="16"
                        Padding="8,4"
                        Margin="0,0,0,8"
                        HorizontalAlignment="Left">
                    <TextBlock Text="{Binding DirectionsDisplay, ElementName=CardControl}"
                               FontSize="12"
                               Foreground="#FF4D00"
                               FontWeight="Medium"/>
                </Border>

                <!-- Стаж -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="📅 " FontSize="12" Foreground="#8E8E93"/>
                    <TextBlock Text="{Binding ExperienceDisplay, ElementName=CardControl}"
                               FontSize="12"
                               Foreground="#8E8E93"/>
                </StackPanel>

                <!-- Описание (ограничение по высоте) -->
                <TextBlock Text="{Binding Description, ElementName=CardControl}"
                           FontSize="13"
                           Foreground="#666666"
                           TextWrapping="Wrap"
                           LineHeight="18"
                           MaxHeight="60"
                           Margin="0,0,0,12"
                           TextTrimming="WordEllipsis"/>

                <!-- Кнопки -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Редактировать"
                            Background="Transparent"
                            Foreground="#FF4D00"
                            FontSize="12"
                            Cursor="Hand"
                            Command="{Binding EditCommand, ElementName=CardControl}"
                            CommandParameter="{Binding Trainer, ElementName=CardControl}"
                            Margin="0,0,12,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="12,6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFF5F0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Content="Удалить"
                            Background="Transparent"
                            Foreground="#FF5252"
                            FontSize="12"
                            Cursor="Hand"
                            Command="{Binding DeleteCommand, ElementName=CardControl}"
                            CommandParameter="{Binding Trainer, ElementName=CardControl}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="12,6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFF5F0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>