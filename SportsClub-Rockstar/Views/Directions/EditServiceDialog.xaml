<Window x:Class="Rockstar.Admin.WPF.Views.Directions.EditServiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование услуги" 
        Width="500" Height="550"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FA">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   Text="Редактирование услуги" 
                   x:Name="tbTitle"
                   FontSize="20" 
                   FontWeight="SemiBold" 
                   Foreground="#2C2C2E"
                   Margin="0,0,0,20"/>

        <!-- ScrollViewer с формой -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto"
                      Margin="0,0,0,20">
            <StackPanel>
                <!-- Название -->
                <TextBlock Text="Название услуги" FontSize="14" Foreground="#2C2C2E" Margin="0,0,0,5"/>
                <TextBox x:Name="tbName" 
                         Height="40" 
                         Padding="12,0" 
                         FontSize="14"
                         Background="White" 
                         BorderBrush="#E8E8ED" 
                         BorderThickness="1"
                         Margin="0,0,0,15"/>

                <!-- Цена -->
                <TextBlock Text="Цена (₽)" FontSize="14" Foreground="#2C2C2E" Margin="0,0,0,5"/>
                <TextBox x:Name="tbPrice" 
                         Height="40" 
                         Padding="12,0" 
                         FontSize="14"
                         Background="White" 
                         BorderBrush="#E8E8ED" 
                         BorderThickness="1"
                         Margin="0,0,0,15"
                         PreviewTextInput="NumberValidationTextBox"/>

                <!-- Количество занятий -->
                <TextBlock Text="Количество занятий" FontSize="14" Foreground="#2C2C2E" Margin="0,0,0,5"/>
                <TextBox x:Name="tbSessionsCount" 
                         Height="40" 
                         Padding="12,0" 
                         FontSize="14"
                         Background="White" 
                         BorderBrush="#E8E8ED" 
                         BorderThickness="1"
                         Margin="0,0,0,15"
                         PreviewTextInput="NumberValidationTextBox"/>

                <!-- Длительность -->
                <TextBlock Text="Длительность (минут)" FontSize="14" Foreground="#2C2C2E" Margin="0,0,0,5"/>
                <TextBox x:Name="tbDuration" 
                         Height="40" 
                         Padding="12,0" 
                         FontSize="14"
                         Background="White" 
                         BorderBrush="#E8E8ED" 
                         BorderThickness="1"
                         Margin="0,0,0,15"
                         PreviewTextInput="NumberValidationTextBox"/>

                <!-- Описание -->
                <TextBlock Text="Описание" FontSize="14" Foreground="#2C2C2E" Margin="0,0,0,5"/>
                <TextBox x:Name="tbDescription" 
                         Height="80" 
                         Padding="12,8" 
                         FontSize="14"
                         Background="White" 
                         BorderBrush="#E8E8ED" 
                         BorderThickness="1"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right">
            <Button Content="Отмена" 
                    Width="100" Height="40" 
                    Margin="0,0,10,0"
                    Click="Cancel_Click"
                    Cursor="Hand"/>
            <Button Content="Сохранить" 
                    Width="100" Height="40" 
                    Background="#FF4D00" 
                    Foreground="White"
                    Click="Save_Click"
                    Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>